{
  "name": "medical-record-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "typecheck": "pnpm typecheck:prepare && pnpm -r --if-present typecheck && tsc -p tsconfig.scripts.json",
    "typecheck:prepare": "tsc -b packages/shared packages/core --force",
    "dev:api": "pnpm --filter @medical-record-agent/api dev",
    "dev:web": "pnpm --filter medical-ui dev",
    "eval:manifest": "tsx scripts/evaluation-manifest.ts",
    "eval:run": "tsx scripts/evaluation-runner-smoke.ts",
    "smoke:web": "tsx scripts/demo-web-basic-e2e.ts",
    "e2e:web:browser": "tsx scripts/demo-web-browser-e2e.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "readiness:external-blockers": "tsx scripts/external-blocker-readiness.ts",
    "readiness:served-app": "tsx scripts/served-app-readiness.ts",
    "readiness:session-invalidation": "tsx scripts/session-invalidation-readiness.ts",
    "readiness:queue-broker": "tsx scripts/queue-broker-readiness.ts",
    "readiness:deployment": "tsx scripts/deployment-readiness-gate.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test:e2e": "playwright test",
    "smoke:mock": "PRODUCTION_SMOKE_MODE=mock-production PRODUCTION_SMOKE_BASE_URL=http://localhost:3000 npx tsx scripts/production-smoke.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "undici": "^8.5.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
