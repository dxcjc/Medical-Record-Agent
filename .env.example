# Medical Record Agent - 环境配置示例
# ===========================================
# 业务配置（OCR、LLM、LIMS）已迁移至数据库 ProviderConfig 表。
# 仅保留基础设施配置。通过管理后台 > Provider 管理页面配置业务 Provider。
# ===========================================

# 数据库
DATABASE_URL="postgresql://user:password@localhost:5432/medical_record_agent?schema=public"

# 服务配置
PORT=3000
HOST=0.0.0.0
API_SERVICE_MODE=production

# JWT 配置（至少 32 字符）
JWT_SECRET="replace-with-your-secure-jwt-secret-at-least-32-chars"

# 存储配置
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# S3 存储配置（当 STORAGE_DRIVER=s3 时必需）
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="medical-record-agent"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"
