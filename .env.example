# 数据库配置：仅使用本地占位值，真实环境请通过安全配置平台或部署密钥注入。
DATABASE_URL="postgresql://medical_record_agent:change_me@localhost:5432/medical_record_agent?schema=public"

# JWT 配置：占位密钥不能用于生产环境。
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# 存储配置：默认本地目录，后续可切换到 S3/MinIO 兼容对象存储。
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="medical-record-agent"
S3_ACCESS_KEY_ID="replace-with-access-key"
S3_SECRET_ACCESS_KEY="replace-with-secret-key"

# OCR 配置：占位 endpoint 和 token，避免写入真实密钥。
OCR_PROVIDER="mock"
OCR_ENDPOINT="http://localhost:8088/ocr"
OCR_API_KEY="replace-with-ocr-api-key"

# LLM 配置：支持 mock、langchain、openai-compatible、openai-responses。
# LLM_PROVIDER=langchain 时默认使用 LangChain ChatOpenAI；LLM_BASE_URL 可指向 OpenAI-compatible 网关。
LLM_PROVIDER="mock"
LLM_MODEL="mock-medical-record-extractor"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="replace-with-llm-api-key"
OPENAI_API_KEY="replace-with-openai-api-key"

# LIMS 测试环境配置：只保留安全占位值，不写真实内网凭据。
LIMS_BASE_URL="http://localhost:8090"
LIMS_CLINICAL_INFO_ENDPOINT="/api/clinical-info/writeback"
LIMS_API_TOKEN="replace-with-lims-api-token"
LIMS_TIMEOUT_MS="10000"

# Production smoke：默认只建议跑 status/login/provider health。
# 开启识别或写回前，只能使用合成样本或审批后的强脱敏样本。
PRODUCTION_SMOKE_BASE_URL="http://localhost:3000"
PRODUCTION_SMOKE_EMAIL="admin@example.local"
PRODUCTION_SMOKE_PASSWORD="replace-with-smoke-user-password"
PRODUCTION_SMOKE_EXPECTED_MODE="production"
PRODUCTION_SMOKE_RUN_RECOGNITION="false"
PRODUCTION_SMOKE_RUN_WRITEBACK="false"
PRODUCTION_SMOKE_SCHEMA_KEY="lims-clinical-info"
PRODUCTION_SMOKE_OCR_PROVIDER_KEY="http-ocr"
PRODUCTION_SMOKE_PROVIDER_KEY="openai-responses"
PRODUCTION_SMOKE_SYNTHETIC_FILE_NAME="production-smoke-medical-record.txt"
PRODUCTION_SMOKE_SYNTHETIC_MIME_TYPE="text/plain"
PRODUCTION_SMOKE_SYNTHETIC_FILE_BASE64=""

# 评估 manifest 受控导入：只在明确执行 pnpm eval:manifest --import <manifest> 时使用。
EVALUATION_API_BASE_URL="http://localhost:3000"
EVALUATION_API_ACCESS_TOKEN="replace-with-evaluation-manage-token"
EVALUATION_DATASET_ID="replace-with-evaluation-dataset-id"
EVALUATION_PROVIDER_KEY="openai-responses"
EVALUATION_SCHEMA_KEY="lims-clinical-info"
EVALUATION_SAMPLE_LIMIT="5"
